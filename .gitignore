# ===============================
# GATOS DA LAGOA — .gitignore
# Projeto PHP + MVC + API REST
# ===============================

# -------------------------------
# Composer
# -------------------------------
/vendor/

# -------------------------------
# Configurações sensíveis
# -------------------------------
.env
.env.local
.env.production
.env.development

# -------------------------------
# Logs
# -------------------------------
/storage/logs/*.log
!/storage/logs/.gitkeep

# -------------------------------
# Uploads enviados em produção
# -------------------------------
# Mantemos as imagens de exemplo atualmente versionadas.
# Descomente para ignorar novos uploads:
# /public/assets/images/uploads/*

# -------------------------------
# Sistema / Windows
# -------------------------------
.DS_Store
Thumbs.db

# -------------------------------
# IDEs / Editores
# -------------------------------
/.vscode/
/.idea/

# -------------------------------
# Arquivos temporários
# -------------------------------
*.tmp
*.cache
